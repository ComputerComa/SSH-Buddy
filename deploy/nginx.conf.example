server {
    listen 443 ssl;
    http2 on;
    server_name keys.home.example;
    ssl_certificate     /etc/ssl/keys.home.example/fullchain.pem;
    ssl_certificate_key /etc/ssl/keys.home.example/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5000;   # or the LXC's address if nginx runs elsewhere
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client-supplied values
        proxy_set_header X-Forwarded-Proto $scheme;
        # Blazor Server uses WebSockets
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 100s;
        client_max_body_size 64k;
    }
}
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server { listen 80; server_name keys.home.example; return 301 https://$host$request_uri; }

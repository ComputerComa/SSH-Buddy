# Copy to /etc/ssh-buddy/ssh-buddy.env, chown root:ssh-buddy, chmod 0640. Never commit the real file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
ConnectionStrings__Default=Data Source=/var/lib/ssh-buddy/sshbuddy.db
DataProtection__KeysDirectory=/var/lib/ssh-buddy/keys
# Host name clients and the browser use, e.g. keys.home.example
AllowedHosts=keys.home.example
App__PublicBaseUrl=https://keys.home.example
# The reverse proxy's address(es): the ONLY sources whose X-Forwarded-* headers are trusted.
ReverseProxy__KnownProxies__0=127.0.0.1
# ReverseProxy__KnownNetworks__0=10.0.0.0/24
# Without TLS and without a reverse proxy (a deliberate choice for a trusted network; see docs/deployment.md),
# change ASPNETCORE_URLS and App__PublicBaseUrl above to these and add the last line:
# ASPNETCORE_URLS=http://0.0.0.0:80
# App__PublicBaseUrl=http://keys.home.example
# Security__RequireHttps=false
Enrollment__TokenLifetimeMinutes=15
# Machines page: a machine with no contact for this many days is shown as stale (never deleted or revoked automatically).
Machines__StaleAfterDays=3
# How long "Permit re-enrollment" stays usable (single use).
Machines__ReenrollPermitMinutes=240
# Where the Go agent releases live (one sub-directory per version, produced by agent/build.sh).
Agent__ReleaseDirectory=/var/lib/ssh-buddy/agent
# Per-minute limits. Check-ins are limited per machine credential, not per IP.
# RateLimits__MachineEnrollPerMinute=60
# RateLimits__CheckInPerMinute=20
# Ceiling for /api/machines/* per client address (many machines may share a NAT address):
# RateLimits__MachineApiPerIpPerMinute=600

[Unit]
Description=SSH Buddy (central authorized_keys management)
After=network-online.target
Wants=network-online.target

[Service]
User=ssh-buddy
Group=ssh-buddy
WorkingDirectory=/opt/ssh-buddy
EnvironmentFile=/etc/ssh-buddy/ssh-buddy.env
# Apply any pending EF Core migrations before every start (idempotent).
ExecStartPre=/opt/ssh-buddy/SshBuddy.Web migrate
ExecStart=/opt/ssh-buddy/SshBuddy.Web
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# Lets the unprivileged service listen on port 80/443 itself when there is no reverse proxy (docs/deployment.md).
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

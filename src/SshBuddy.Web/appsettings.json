{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "Data Source=App_Data/sshbuddy.db" },
  "DataProtection": { "KeysDirectory": "App_Data/keys" },
  "Enrollment": { "TokenLifetimeMinutes": 15 },
  "RateLimits": { "LoginPerMinute": 5, "EnrollPerMinute": 10, "MachineEnrollPerMinute": 60, "CheckInPerMinute": 20, "MachineApiPerIpPerMinute": 600 },
  "Machines": { "StaleAfterDays": 3, "ReenrollPermitMinutes": 240 },
  "Agent": { "ReleaseDirectory": "App_Data/agent" },
  "ReverseProxy": { "KnownProxies": [], "KnownNetworks": [] }
}

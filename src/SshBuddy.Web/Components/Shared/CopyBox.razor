@inject IJSRuntime JS

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label fw-semibold" for="@id">@Label</label>
    }
    <textarea id="@id" class="form-control font-monospace" rows="@Rows" readonly onfocus="this.select()">@Value</textarea>
    <div class="mt-2">
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CopyAsync">@(copied ? "Copied" : "Copy")</button>
    </div>
</div>

@code {
    private readonly string id = "cb-" + Guid.NewGuid().ToString("N")[..8];
    private bool copied;

    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Label { get; set; }
    [Parameter] public int Rows { get; set; } = 3;

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Value);
            copied = true;
        }
        catch (JSException)
        {
            // The clipboard API needs a secure context; the textarea selects on focus for a manual copy.
        }
    }
}

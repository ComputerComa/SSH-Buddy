@page "/login"
@attribute [AllowAnonymous]

<PageTitle>Sign in · SSH Buddy</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <h1 class="h3 mb-3">Sign in</h1>
        @if (Error == "locked")
        {
            <AlertMessage Message="Too many failed attempts. Try again later." />
        }
        else if (Error is not null)
        {
            <AlertMessage Message="Invalid email or password." />
        }
        <form method="post" action="/account/login">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input id="email" name="Email" type="email" class="form-control" autocomplete="username" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <input id="password" name="Password" type="password" class="form-control" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}
